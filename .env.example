# ================================
# SEO Factory - Environment Variables
# ================================
# Copy this file to .env.local for development
# For production, add these to your Railway/hosting provider

# ================================
# Database (PostgreSQL)
# ================================
# Railway auto-populates this for PostgreSQL add-ons
DATABASE_URL="postgresql://user:password@localhost:5432/seo_factory?schema=public"

# ================================
# Redis (Queue & Caching)
# ================================
# Railway auto-populates this for Redis add-ons
REDIS_URL="redis://localhost:6379"

# ================================
# Application
# ================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ================================
# Clerk Authentication
# ================================
# Get these from: https://dashboard.clerk.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/signin"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Clerk Webhook Secret (for user.created/user.deleted events)
# Get from: Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET="whsec_..."

# ================================
# Resend (Email)
# ================================
# Get these from: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Must be a verified domain in Resend
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ================================
# Stripe (Payments)
# ================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Get from: Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# Create these in Stripe Dashboard → Products
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."

# ================================
# Claude AI (Content Generation)
# ================================
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Alias used in some parts of the codebase
CLAUDE_API_KEY="sk-ant-..."

# ================================
# SERP API (Search Results)
# ================================
# Get from: https://serpapi.com
SERP_API_KEY="your-serp-api-key"

# ================================
# Vercel Blob (File Storage)
# ================================
# Get from: https://vercel.com/dashboard/stores
# Create a new Blob store and copy the token
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ================================
# Admin Configuration
# ================================
# Comma-separated list of admin email addresses
# These users can access /admin routes
ADMIN_EMAILS="admin@yourdomain.com"

# ================================
# Internal Secrets
# ================================
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET="your-internal-secret"
CRON_SECRET="your-cron-secret"

# ================================
# Optional: Analytics
# ================================
# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
