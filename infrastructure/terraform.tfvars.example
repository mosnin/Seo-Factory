# ================================
# Terraform Variables - Example Configuration
# ================================
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars with secrets to version control

# ================================
# General Configuration
# ================================
project_name = "seo-factory"
environment  = "prod"
aws_region   = "us-east-1"

# ================================
# VPC Configuration
# ================================
vpc_cidr                 = "10.0.0.0/16"
availability_zones_count = 2

# ================================
# ECS Configuration
# ================================
app_cpu           = 512   # 0.5 vCPU
app_memory        = 1024  # 1 GB
app_desired_count = 2
app_min_count     = 1
app_max_count     = 10
container_port    = 3000

# ================================
# RDS Configuration
# ================================
db_instance_class          = "db.t3.micro"  # Use db.t3.small or larger for production
db_allocated_storage       = 20
db_max_allocated_storage   = 100
db_engine_version          = "15.4"
db_name                    = "seo_factory"
db_username                = "seo_factory_admin"
db_backup_retention_period = 7
db_multi_az                = false  # Set to true for production
db_deletion_protection     = true

# ================================
# ElastiCache Configuration
# ================================
redis_node_type       = "cache.t3.micro"  # Use cache.t3.small or larger for production
redis_num_cache_nodes = 1
redis_engine_version  = "7.0"

# ================================
# ALB Configuration
# ================================
health_check_path = "/api/health"

# SSL Certificate (get ARN from ACM or leave empty to create new)
ssl_certificate_arn = ""

# Your domain name (must have DNS pointing to ALB)
domain_name = "seo-factory.example.com"

# ================================
# Cognito Configuration
# ================================
cognito_callback_urls = [
  "http://localhost:3000/api/auth/callback/cognito",
  "https://seo-factory.example.com/api/auth/callback/cognito"
]

cognito_logout_urls = [
  "http://localhost:3000",
  "https://seo-factory.example.com"
]

# ================================
# S3 Configuration
# ================================
s3_force_destroy = false  # Set to true only for dev/test environments

# ================================
# Email Configuration
# ================================
ses_from_email = "noreply@seo-factory.example.com"  # Must be verified in SES

# ================================
# Application Secrets
# ================================
# These should be passed via environment variables or CI/CD secrets
# export TF_VAR_nextauth_secret="your-secret"
# export TF_VAR_claude_api_key="your-api-key"
# export TF_VAR_stripe_secret_key="your-stripe-key"
# export TF_VAR_stripe_webhook_secret="your-webhook-secret"

# Uncomment and fill in if not using environment variables:
# nextauth_secret       = ""
# claude_api_key        = ""
# stripe_secret_key     = ""
# stripe_webhook_secret = ""
