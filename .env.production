# ================================
# SEO Factory - Production Environment Configuration
# ================================
# Copy this file to .env.production.local and fill in the values
# NEVER commit secrets to version control

# ================================
# Core Application
# ================================
NODE_ENV=production
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=  # Generate with: openssl rand -base64 32

# ================================
# Database (PostgreSQL)
# ================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# ================================
# Redis (Queue & Caching)
# ================================
# Format: redis://HOST:PORT
REDIS_URL=

# ================================
# Claude AI API
# ================================
CLAUDE_API_KEY=  # Get from https://console.anthropic.com

# ================================
# Stripe Payments
# ================================
STRIPE_SECRET_KEY=  # Get from Stripe Dashboard
STRIPE_WEBHOOK_SECRET=  # Get from Stripe Webhook settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # Public key for frontend

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=

# ================================
# AWS Configuration
# ================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 Buckets
S3_UPLOADS_BUCKET=
S3_EXPORTS_BUCKET=
CDN_URL=  # CloudFront domain

# AWS SES (Email)
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@your-domain.com

# ================================
# AWS Cognito (Authentication)
# ================================
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=  # https://cognito-idp.{region}.amazonaws.com/{user-pool-id}

# ================================
# Admin Configuration
# ================================
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@your-domain.com

# ================================
# Internal Secrets
# ================================
# Secret for internal webhooks (Stripe -> App communication)
INTERNAL_WEBHOOK_SECRET=  # Generate with: openssl rand -hex 32

# Secret for cron jobs (verify scheduled task requests)
CRON_SECRET=  # Generate with: openssl rand -hex 32

# ================================
# Monitoring & Analytics (Optional)
# ================================
# Sentry for error tracking
SENTRY_DSN=

# PostHog for product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ================================
# Rate Limiting
# ================================
# Max requests per minute for API routes
RATE_LIMIT_MAX=100
